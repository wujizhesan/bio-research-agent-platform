# Optional LLM configuration
CADD_API_KEY=
OPENAI_API_KEY=

# Optional API protection
CADD_API_TOKEN=
CADD_JWT_SECRET=
CADD_AUTH_USERS_JSON=
AUTH_TOKEN_TTL_SECONDS=3600
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=60

# Optional PubMed API key
NCBI_API_KEY=

# Optional external mRNA-Forge plugin root
MRNA_FORGE_ROOT=
DATABASE_URL=sqlite+aiosqlite:///./output/bio-agent.db
POSTGRES_DB=bioagent
POSTGRES_USER=bioagent
POSTGRES_PASSWORD=change-me-in-development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_SCHEMA=true
JOB_BACKEND=local
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=bioagent
JOB_LEASE_SECONDS=300
JOB_RESULT_TTL_SECONDS=86400
WORKER_METRICS_PORT=9000
WORKER_METRICS_PUBLISHED_PORT=9000
UPLOAD_ROOT=output/uploads
UPLOAD_MAX_BYTES=52428800
API_PUBLISHED_PORT=8000
